# Local persistent storage (default). Paths are relative to backend/.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=data/pocketwise.sqlite
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set DATABASE_MODE=supabase to use hosted Postgres. JWT_SECRET is mandatory.
# Copy the Session pooler URI from Supabase > Connect; URL-encode the password.
# Backend secret only: never put this connection string in Flutter.
SUPABASE_DB_URL=

# Required for both local and Supabase storage. Mount this secret outside Git.
# JSON: {"active_key_id":"v1","keys":{"v1":"<base64-encoded 32-byte key>"}}
# Generate securely and migrate existing records: see docs/ENCRYPTION.md.
DOCUMENT_ENCRYPTION_KEY_FILE=

# Password recovery: Mailpit captures local test messages at http://localhost:8025.
# Start it with: docker compose -f compose.mail.yaml up -d (from repository root).
# For real delivery use your provider, SMTP_SECURITY=starttls (587) or tls (465).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=local
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Pocketwise <noreply@localhost>
# Optional URL of your Flutter web app, HTTPS in production. Native users can paste the code.
PASSWORD_RESET_URL=

# Reserved for the planned financial helper and guilt-free wishlist.
# Transaction parsing always uses local rules; these settings are not active yet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
