# Local persistent storage (default). Paths are relative to backend/.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=data/pocketwise.sqlite
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set DATABASE_MODE=mongo to enable MongoDB. JWT_SECRET is mandatory then.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pocketwise

# Reserved for the planned financial helper and guilt-free wishlist.
# Transaction parsing always uses local rules; these settings are not active yet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
